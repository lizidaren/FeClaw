# FeClaw 配置模板
# 复制为 .env 并填入实际值
# 首次启动请访问 /setup?token=xxx（控制台打印），完成冷启动向导

# ════════════════════════════════════════════════
# 🔑 安全
# ════════════════════════════════════════════════
JWT_SECRET=                                   # ⚠️ 必填！JWT 签名密钥（任意足够长的随机字符串）
# DEBUG=False                                 # 调试模式（生产请保持关闭，开启会暴露错误详情）

# ════════════════════════════════════════════════
# 🌐 域名部署（仅生产域名部署时需要）
# ════════════════════════════════════════════════
# FECLAW_PUBLIC_URL=feclaw.example.com         # 服务器访问地址（域名或 IP:端口）。纯 IP 部署留空即可
# FECLAW_SUBDOMAIN_ENABLED=false               # Agent 子域名模式（需要域名+DNS 泛解析支持）

# ════════════════════════════════════════════════
# 🗄️ 数据库
# ════════════════════════════════════════════════
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/feclaw  # ⚠️ 必填！MySQL 连接串

# ════════════════════════════════════════════════
# 🤖 LLM 提供商（至少配置一个，否则无法对话）
# ════════════════════════════════════════════════
# 推荐配置 DeepSeek + 千问（廉价且效果好）
DEEPSEEK_API_KEY=                             # DeepSeek（deepseek-flash / deepseek-v4-pro）
QWEN_API_KEY=                                 # 通义千问（qwen 系列 / text-embedding-v4）
ZHIPU_API_KEY=                                # 智谱 AI（glm 系列 / embedding-3）
MIMO_API_KEY=                                 # MiMo（mimo-v2-flash / mimo-v2-pro）
DOUBAO_API_KEY=                               # 豆包 / 火山引擎
KIMI_API_KEY=                                 # Kimi / Moonshot（联网搜索用）

# LLM 模型默认配置（非必填，冷启动向导可交互选择）
# MAIN_TEXT_MODEL=deepseek-flash            # 主文本模型
# MAIN_VISION_MODEL=qwen3.6-35b-a3b           # 主视觉模型
# MAIN_EMBEDDING_MODEL=text-embedding-v4      # 主嵌入模型（可用 embedding-3）
# DEFAULT_SEARCH_ENGINE=qwen                  # 默认搜索后端（qwen/glm/kimi）

# ════════════════════════════════════════════════
# ☁️ 对象存储（可选项）
# ════════════════════════════════════════════════
# STORAGE_MODE=auto                           # 存储模式：local（本地）/ cos / auto
# LOCAL_STORAGE_ROOT=./feclaw-storage         # 本地存储根目录
# VECTOR_STORAGE_BACKEND=numpy                # 向量存储后端：numpy / cos / sqlite
# STORAGE_PREFIX=feclaw/                      # 存储前缀，隔离多实例

# 腾讯云 COS（选择 cos 模式时必填）
# TENCENT_COS_SECRET_ID=
# TENCENT_COS_SECRET_KEY=
# TENCENT_COS_BUCKET=
# TENCENT_COS_APPID=
# TENCENT_COS_REGION=ap-guangzhou

# ════════════════════════════════════════════════
# 📦 Redis（可选，用于缓存/会话/性能追踪）
# ════════════════════════════════════════════════
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=
# REDIS_ENABLED=                               # 显式开关 true/false；留空按旧规则（有用户名/密码即启用）

# ════════════════════════════════════════════════
# 🔐 OAuth / OIDC（可选，默认使用本地注册/登录）
# ════════════════════════════════════════════════
# 配置后可在「管理后台 → 配置 → OAuth / SSO」编辑
# OAUTH_ENABLED=true
# OAUTH_PROVIDER_NAME=OAuth/OIDC 认证服务
# OAUTH_PROVIDER_URL=https://your-idp.example.com
# OAUTH_CLIENT_ID=feclaw
# OAUTH_CLIENT_SECRET=your-client-secret
# OAUTH_REDIRECT_URI=https://feclaw.example.com/api/oauth/callback

# OAuth token / userinfo 端点（FIX-F G6）。⚠️ 每个键只能出现一次 —— pydantic-settings
# 取最后一次出现，重复键会造成端口/路径漂移（历史事故：8081 与 58081 各写一次，
# 生效的是后者）。若走 OIDC 标准路径可完全留空（默认 {OAUTH_PROVIDER_URL}/token 与
# /userinfo）。端口需与 OAuth Provider 实际监听端口一致（本项目 Platform 为 8081）。
# OAUTH_TOKEN_URL=http://127.0.0.1:8081/token
# OAUTH_USERINFO_URL=http://127.0.0.1:8081/userinfo

# ════════════════════════════════════════════════
# ⚙️ 高级配置（通常不需要修改）
# ════════════════════════════════════════════════
# HOST=0.0.0.0                                # 监听地址
# PORT=8080                                    # 监听端口
# LOG_LEVEL=INFO                               # 日志级别（DEBUG/INFO/WARNING/ERROR）
# COOKIE_SECURE=false                          # Cookie Secure 标记（HTTPS 开启）
# JWT_EXPIRE_HOURS=24                          # JWT 过期时间
# CACHE_TTL=300                                # 缓存 TTL（秒）
# DESKTOP_ENABLED=false                        # 桌面端 API
# WECHAT_ILINK_API_KEY=                        # 微信 iLink API Key
# MINERU_TOKEN=                                # MinerU 文档解析 Token
# MINIMAX_API_KEY=                             # MiniMax（TTS 语音合成）
# FECLAW_VENV_PATH=./venv                      # 沙箱运行环境路径
# FUSE_MOUNT_DIR=./feclaw-fuse                 # FUSE 挂载目录
# FUSE_ENABLED=false                           # FUSE 文件系统
# SANDBOX_MAX_RUNTIME_HOURS=1                  # 沙箱最大运行时间

# ════════════════════════════════════════════════
# 🛡️ 注册 / CSRF / 限流（T18a）
# ════════════════════════════════════════════════
# REGISTRATION_MODE=invite                     # open（公开）/ invite（需邀请码，默认）/ closed
# REGISTRATION_INVITE_CODE=                    # invite 模式必填；未配置时等价 closed（fail-closed）
# REGISTRATION_DEFAULT_TIER=free               # 新用户默认套餐
# RATE_LIMIT_BACKEND=memory                    # memory（单进程）/ redis（多 worker 共享计数）
# RATE_LIMIT_FAIL_MODE=closed                  # closed（Redis 不可用即拒绝，默认）/ open（有界内存兜底）
# RATE_LIMIT_REDIS_PREFIX=ratelimit:
# RATE_LIMIT_REDIS_TIMEOUT=0.5
# RATE_LIMIT_LOGIN_ATTEMPTS=10                 # 各桶阈值（按需覆盖；缺省见 config.py）
# RATE_LIMIT_LOGIN_WINDOW=300
# RATE_LIMIT_LOGIN_IP_ATTEMPTS=100             # 同一 IP 的登录尝试上限
# RATE_LIMIT_REGISTER_ATTEMPTS=5               # 同一 IP 的注册上限
# RATE_LIMIT_REGISTER_WINDOW=3600
# RATE_LIMIT_PASSWORD_ATTEMPTS=10              # 改密/密码校验
# RATE_LIMIT_PASSWORD_WINDOW=300
# RATE_LIMIT_TOTP_ATTEMPTS=10                  # TOTP 校验
# RATE_LIMIT_TOTP_WINDOW=300
# CSRF_ENABLED=true                            # Origin/Referer 校验 + 双提交 token（cookie 会话的 mutation）
# CSRF_COOKIE_NAME=feclaw_csrf
# CSRF_HEADER_NAME=X-CSRF-Token
# CSRF_REQUIRE_ORIGIN=false                    # true=连“无 Origin/Referer”也拒绝跨站 mutation（更严格）
# CSRF_EXTRA_ORIGINS=                          # JSON 列表，额外可信 Origin
# WS_REQUIRE_ORIGIN=false                      # true=所有 WS 握手都必须带合法 Origin
# WS_EXTRA_ORIGINS=                            # JSON 列表

# ════════════════════════════════════════════════
# 📤 分享链接（T17a）
# ════════════════════════════════════════════════
# SHARE_DEFAULT_EXPIRES_HOURS=24               # 默认有效期（小时）
# SHARE_MAX_EXPIRES_HOURS=0                    # 0=不限制上限
# SHARE_ALLOW_PERMANENT=false                  # 是否允许“永久”分享
# SHARE_UNLOCK_TTL_SECONDS=600                 # 密码解锁 proof 有效期
# SHARE_ACTIVE_ORIGIN=                         # 独立分享域；空=主动内容只允许下载（attachment）

# ════════════════════════════════════════════════
# 📚 API 文档（T18a/F8）
# ════════════════════════════════════════════════
# FECLAW_EXPOSE_DOCS=0                         # 1/true 才挂载 /docs、/redoc、/openapi.json（默认关闭）
